# ===== ML Service =====
GEMINI_API_KEY=your-google-ai-studio-key
FILE_SEARCH_STORE_NAME=fileSearchStores/your-store-id
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional overrides (defaults point at ml-service/models/)
PNEUMONIA_MODEL_PATH=models/pneumonia_model.keras
LUNG_CANCER_MODEL_PATH=models/lung_cancer_model.keras
ALZHEIMER_MODEL_PATH=models/alzheimer_model.keras

FLASK_DEBUG=False
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:3000

# ===== Backend =====
# Required: at least 32 random characters. Rotate periodically and after any exposure.
JWT_SECRET=change-me-to-a-long-random-string
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/healthmate_db
SPRING_DATASOURCE_USERNAME=healthmate_user
SPRING_DATASOURCE_PASSWORD=change-me
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ML_API_URL=http://localhost:5000
